rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if request is from authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Public read access for images and PDF reports; write access for Admin only
    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reports/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
